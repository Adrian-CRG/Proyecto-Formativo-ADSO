*{
    box-sizing: border-box;
}
body{
    background-color: rgb(157, 240, 243);
}
nav{
    background-color: peru;
    border: 1px solid blue; 
    text-align: center;
    border-radius: 7px;
}

input{
    width: 300px;
    border-radius: 6px;
    border: none;
    padding: 4px;
}
button{
    padding: 4px;
    border: none;
    border-radius: 7px;
}
table{
    text-align: center;
}
td{
    padding: 3px;
    width: 200px;
}
